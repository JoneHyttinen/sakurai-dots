{
    "appearance": {
        "font": "JetBrains Mono",
        "fontScale": 1.1,
        "frameRadius": 15,
        "frameSide": 8,
        "frameTop": 45,
        "radius": 12
    },
    "bar": {
        "dateFormat": "ddd d MMM",
        "showBattery": false,
        "showDashboardButton": true,
        "showDate": true,
        "showGaming": true,
        "showNetwork": true,
        "showNotifications": true,
        "showScratchpad": true,
        "showSeconds": false,
        "showTray": true,
        "showVolume": true,
        "timeFormat": "24h",
        "workspaceStyle": "numbers"
    },
    "dock": {
        "mode": "empty",
        "showMemory": true,
        "showRunning": true,
        "themedTiles": true
    },
    "hyprland": {
        "activeOpacity": 0.92,
        "animSpeed": "normal",
        "animations": true,
        "blur": true,
        "blurPasses": 1,
        "blurSize": 8,
        "borderSize": 2,
        "gapsIn": 4,
        "gapsOut": 10,
        "inactiveOpacity": 0.85,
        "matchFrame": true,
        "rounding": 12,
        "shadow": true,
        "shadowRange": 28
    },
    "notifications": {
        "keepCritical": true,
        "maxPopups": 4,
        "screen": "primary",
        "timeout": 5
    },
    "performance": {
        "mediaBlur": true,
        "statsInterval": 1000,
        "visualizer": true,
        "windowPreviews": true
    },
    "wallpaper": {
        "folder": "",
        "monoThreshold": 0.08,
        "scheme": "auto",
        "transition": "fade",
        "transitionDuration": 1.5
    }
}
