{
    "appearance": {
        "font": "JetBrains Mono",
        "fontScale": 1.1,
        "frameRadius": 15,
        "frameSide": 8,
        "frameTop": 45,
        "radius": 12
    },
    "bar": {
        "dateFormat": "ddd d MMM",
        "showBattery": false,
        "showDashboardButton": true,
        "showDate": true,
        "showGaming": true,
        "showNetwork": true,
        "showNotifications": true,
        "showScratchpad": true,
        "showSeconds": false,
        "showTray": true,
        "showVolume": true,
        "timeFormat": "24h",
        "workspaceStyle": "numbers"
    },
    "dock": {
        "mode": "empty",
        "showMemory": true,
        "showRunning": true,
        "themedTiles": true
    },
    "notifications": {
        "keepCritical": true,
        "maxPopups": 4,
        "screen": "primary",
        "timeout": 5
    },
    "wallpaper": {
        "folder": "",
        "monoThreshold": 0.08,
        "scheme": "auto",
        "transition": "fade",
        "transitionDuration": 1.5
    }
}
