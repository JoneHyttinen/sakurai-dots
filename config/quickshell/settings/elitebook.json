{
    "appearance": {
        "font": "Geist",
        "fontScale": 1.15,
        "frameRadius": 18,
        "frameSide": 8,
        "frameTop": 35,
        "radius": 12
    },
    "bar": {
        "dateFormat": "ddd d MMM",
        "showBattery": true,
        "showDashboardButton": true,
        "showDate": true,
        "showGaming": false,
        "showNetwork": true,
        "showNotifications": true,
        "showScratchpad": true,
        "showSeconds": false,
        "showTray": true,
        "showVolume": true,
        "timeFormat": "24h",
        "workspaceStyle": "dots"
    },
    "dock": {
        "mode": "empty",
        "showMemory": true,
        "showRunning": true,
        "themedTiles": true
    },
    "notifications": {
        "keepCritical": true,
        "maxPopups": 5,
        "screen": "primary",
        "timeout": 5
    },
    "performance": {
        "mediaBlur": false,
        "statsInterval": 2000,
        "visualizer": false,
        "windowPreviews": false
    },
    "wallpaper": {
        "folder": "",
        "monoThreshold": 0.08,
        "scheme": "auto",
        "transition": "grow",
        "transitionDuration": 1
    }
}
