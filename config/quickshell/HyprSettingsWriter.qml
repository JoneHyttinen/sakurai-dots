import QtQuick
import Quickshell
import Quickshell.Io

// Writes the Hyprland tab's settings to a Lua file that hyprland.lua loads
Scope {
    id: root
    readonly property string dir: Quickshell.env("HOME") + "/.local/state/hypr"
    readonly property var h: Config.hyprland

    // Concentric corners: window rounding + outer gap = the frame's inner corner
    readonly property int rounding: h.matchFrame ? Math.max(0, Config.appearance.frameRadius - h.gapsOut) : h.rounding

    // Hyprland's animation "speed" is a duration, so a smaller number is faster
    readonly property real animFactor: h.animSpeed === "fast" ? 0.6 : h.animSpeed === "slow" ? 1.5 : 1.0
    function speed(base) {
        return Math.max(1, Math.round(base * animFactor * 10) / 10);
    }

    // Hyprland colors: rgba(rrggbbaa)
    function hyprColor(hex, alpha) {
        const a = Math.round(Math.max(0, Math.min(1, alpha)) * 255).toString(16).padStart(2, "0");
        return "rgba(" + hex.replace("#", "") + a + ")";
    }

    readonly property string luaText: {
        const b = v => v ? "true" : "false";
        const style = h.shadowStyle;
        const shadowOn = style !== "none";
        // Glow: accent color around the focused window, a faint dark shadow on the others
        const activeColor = style === "glow" ? hyprColor(Theme.colors.primary, h.glowStrength) : "rgba(0000004d)";
        const inactiveColor = style === "glow" ? "rgba(00000033)" : "rgba(0000004d)";

        const lines = ["-- Generated by the Quickshell settings window.", "-- Change the settings there; edits to this file are overwritten.", "hl.config({", "  general = {", "    gaps_in = " + h.gapsIn + ",", "    gaps_out = " + h.gapsOut + ",", "    border_size = " + h.borderSize + ",", "  },", "  decoration = {", "    rounding = " + rounding + ",", "    active_opacity = " + h.activeOpacity.toFixed(2) + ",", "    inactive_opacity = " + h.inactiveOpacity.toFixed(2) + ",", "    blur = { enabled = " + b(h.blur) + ", size = " + h.blurSize + ", passes = " + h.blurPasses + " },", "    shadow = {", "      enabled = " + b(shadowOn) + ",", "      range = " + h.shadowRange + ",", "      render_power = 3,", '      color = "' + activeColor + '",', '      color_inactive = "' + inactiveColor + '",', "    },", "  },", "  animations = { enabled = " + b(h.animations) + " },", "})",];

        if (h.animations) {
            lines.push('hl.animation({ leaf = "global", enabled = true, speed = ' + speed(3) + ', bezier = "quick" })');
            lines.push('hl.animation({ leaf = "windows", enabled = true, speed = ' + speed(3) + ', spring = "easy", style = "slide" })');
            lines.push('hl.animation({ leaf = "workspaces", enabled = true, speed = ' + speed(5) + ', bezier = "quick", style = "slide" })');
        }

        // Frosted-glass shell panels: blur behind see-through parts, but not
        // behind fully transparent areas like the frame's centre
        if (Config.appearance.panelBlur && Config.appearance.panelOpacity < 1) {
            lines.push('hl.layer_rule({');
            lines.push('  match = { namespace = "^qs-(bar|frame|dock|notifications|osd)$" },');
            lines.push('  blur = true,');
            lines.push('  blur_popups = true,');
            lines.push('  ignore_alpha = 0.1,');
            lines.push('})');
        }

        return lines.join("\n") + "\n";
    }

    Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.dir])

    FileView {
        id: file
        path: root.dir + "/settings.lua"
        printErrors: false
    }

    onLuaTextChanged: if (Config.loaded)
        writeSoon.restart()
    Connections {
        target: Config
        function onLoadedChanged() {
            if (Config.loaded)
                writeSoon.restart();
        }
    }

    Timer {
        id: writeSoon
        interval: 400
        onTriggered: {
            file.setText(root.luaText);
            reloadSoon.restart();
        }
    }
    Timer {
        id: reloadSoon
        interval: 150
        onTriggered: Quickshell.execDetached(["hyprctl", "reload"])
    }
}
