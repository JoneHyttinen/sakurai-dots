#!/usr/bin/env bash
# Usage: setwall <image> [source-color]
#   setwall ~/Pictures/Wallpapers/forest.jpg            # prompts for a color
#   setwall ~/Pictures/Wallpapers/forest.jpg "#6f6a75"  # uses this color
# Overrides: MODE=light|dark, TYPE=scheme-...
set -euo pipefail

wall="$(realpath "$1")"
source_color="${2:-}"

# ── Settings from the settings window (settings.json) ────
settings="$HOME/.config/quickshell/settings/$(cat /etc/hostname).json"
cfg() { jq -r "$1 // empty" "$settings" 2>/dev/null || true; }

transition=$(cfg '.wallpaper.transition')
transition=${transition:-grow}
duration=$(cfg '.wallpaper.transitionDuration')
duration=${duration:-1}
threshold=$(cfg '.wallpaper.monoThreshold')
threshold=${threshold:-0.08}
scheme_pref=$(cfg '.wallpaper.scheme')
scheme_pref=${scheme_pref:-auto}

# ── Wallpaper ────────────────────────────────────────────
if ! pgrep -x awww-daemon >/dev/null; then
  awww-daemon >/dev/null 2>&1 &
  disown
  sleep 0.5
fi

awww img "$wall" --transition-type "$transition" --transition-duration "$duration"
ln -sf "$wall" "$HOME/.cache/wallpaper" # used by hyprlock and the picker

# ── Scheme and mode ──────────────────────────────────────
# How colourful and how bright the wallpaper is, from 0 to 1
sat=$(magick "$wall" -resize 256x256 -colorspace HSL -channel G -separate +channel -format "%[fx:mean]" info:)
lum=$(magick "$wall" -resize 256x256 -colorspace Gray -format "%[fx:mean]" info:)

type="scheme-tonal-spot"
mode="dark"
if awk "BEGIN { exit !($sat < $threshold) }"; then
  # Practically no colour: grayscale UI that contrasts with the wallpaper
  type="scheme-monochrome"
  mode=$(awk "BEGIN { print ($lum > 0.5) ? \"dark\" : \"light\" }")
else
  # Colourful: match the wallpaper, light theme for light wallpapers
  mode=$(awk "BEGIN { print ($lum > 0.55) ? \"light\" : \"dark\" }")
fi

# A color style chosen in the settings replaces the automatic choice
if [ "$scheme_pref" != "auto" ]; then
  type="scheme-$scheme_pref"
fi

# Saved choice from the light/dark setting or the dashboard toggle
pref=$(cat "$HOME/.local/state/theme-mode" 2>/dev/null || true)
if [ "$pref" = "light" ] || [ "$pref" = "dark" ]; then
  mode="$pref"
fi

# Manual overrides, e.g. MODE=light setwall img.jpg
type="${TYPE:-$type}"
mode="${MODE:-$mode}"

# No color given and no terminal to ask in (e.g. run from the dashboard):
# use the wallpaper's most prominent color, favouring colourful ones over greys
if [ -z "$source_color" ] && [ ! -t 0 ]; then
  source_color=$(magick "$wall" -resize 96x96 -colors 8 -format "%c" histogram:info:- |
    awk '{
            if (match($0, /#[0-9A-Fa-f]{6}/)) {
                hex = substr($0, RSTART, 7)
                r = strtonum("0x" substr(hex, 2, 2)) / 255
                g = strtonum("0x" substr(hex, 4, 2)) / 255
                b = strtonum("0x" substr(hex, 6, 2)) / 255
                max = r; if (g > max) max = g; if (b > max) max = b
                min = r; if (g < min) min = g; if (b < min) min = b
                sat = max > 0 ? (max - min) / max : 0
                score = ($1 + 0) * (0.15 + sat)
                if (score > best) { best = score; pick = hex }
            }
        } END { print pick }' || true)
fi

# ── Generate all themes ──────────────────────────────────
if [ -n "$source_color" ]; then
  matugen color hex "$source_color" -t "$type" -m "$mode"
else
  matugen image "$wall" -t "$type" -m "$mode"
fi

hyprctl reload >/dev/null

# Remember what was used, for the dashboard's light/dark toggle
printf '{ "mode": "%s", "color": "%s" }\n' "$mode" "$source_color" >"$HOME/.cache/theme-state.json"

# ── GTK: light or dark variant ───────────────────────────
# Written straight to dconf, which gsettings uses underneath; unlike
# gsettings, this needs no installed schemas (they're per-app on NixOS)
if command -v dconf >/dev/null 2>&1; then
  if [ "$mode" = "light" ]; then
    gtk_theme="adw-gtk3"
    color_scheme="prefer-light"
  else
    gtk_theme="adw-gtk3-dark"
    color_scheme="prefer-dark"
  fi
  dconf write /org/gnome/desktop/interface/gtk-theme "'$gtk_theme'"
  dconf write /org/gnome/desktop/interface/color-scheme "'$color_scheme'"
fi

# ── KDE: replace the global colors, keep all other settings ──
kdeglobals="$HOME/.config/kdeglobals"
scheme="$HOME/.local/share/color-schemes/Matugen.colors"
if [ -f "$scheme" ]; then
  touch "$kdeglobals"
  tmp="$kdeglobals.tmp"
  awk '/^\[/ { skip = ($0 ~ /^\[Colors:/) } !skip && !/^ColorScheme(Hash)?=/' "$kdeglobals" >"$tmp"
  awk '/^\[/ { keep = ($0 ~ /^\[Colors:/) } keep' "$scheme" >>"$tmp"
  mv "$tmp" "$kdeglobals"
fi

# ── Neovim: recolor every running instance ───────────────
shopt -s nullglob
for sock in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*.0; do
  nvim --server "$sock" --remote-expr "execute('lua MatugenReload()')" >/dev/null 2>&1 || true
done

# ── Firefox: Pywalfox picks up the new colors ────────────
if command -v pywalfox >/dev/null 2>&1; then
  pywalfox update >/dev/null 2>&1 || true
fi

# ── Spotify: apply the new colors ────────────────────────
if command -v spicetify >/dev/null 2>&1; then
  spicetify refresh >/dev/null 2>&1 || true
fi

# ── fetch: a logo using the themed terminal colors ───────
# fetch would otherwise ask fastfetch for the logo by name,
# which brings back the distro's default colors
if command -v fastfetch >/dev/null 2>&1; then
  mkdir -p "$HOME/.config/fetch"
  fastfetch -s break --pipe false >"$HOME/.config/fetch/logo.txt" 2>/dev/null || true
fi
